config gateway 'main'
	option enabled '0'
	# Name on the TAK map (empty = this device's hostname)
	option callsign ''
	option team 'Cyan'
	option role 'Team Member'
	option type 'a-f-G-U-C'
	# Fixed position of this device (decimal degrees, meters)
	option lat ''
	option lon ''
	option hae ''
	# Use a GPS through gpsd instead of / on top of the fixed position
	option gpsd '0'
	option gpsd_address '127.0.0.1:2947'
	# Seconds between position reports
	option beacon '30'
	option remarks ''

config server 'server'
	option enabled '0'
	option host ''
	option port '8089'
	# ssl (TLS with client certificate) or tcp (plain)
	option protocol 'ssl'
	option cert '/etc/tak-gateway/client.crt.pem'
	option key '/etc/tak-gateway/client.key.pem'
	option ca '/etc/tak-gateway/ca.pem'
	option insecure '0'

config mesh 'mesh'
	option enabled '1'
	# OpenWrt networks to bridge TAK multicast on (lan, a mesh, HaLow...)
	list network 'lan'
	# Extra raw device names (e.g. wlan0-mesh), optional
	#list device 'wlan0'
	option chat '1'
	option to_server '1'
	option from_server '1'
	option bridge '1'
	option ttl '1'
	# Only send these CoT type prefixes from the server to the mesh (empty = all)
	#list from_server_types 'a-'
	#list from_server_types 'b-t-f'
