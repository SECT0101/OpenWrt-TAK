#!/bin/sh /etc/rc.common
# tak-gateway: TAK SA multicast <-> TAK Server bridge

START=95
STOP=10
USE_PROCD=1
PROG=/usr/bin/tak-gateway

append_arg() { [ -n "$2" ] && procd_append_param command "$1" "$2"; }
append_bool() {
	local v
	config_get_bool v "$2" "$3" "$4"
	procd_append_param command "$1=$([ "$v" = 1 ] && echo true || echo false)"
}
add_device() {
	local dev
	if network_get_device dev "$1" 2>/dev/null && [ -n "$dev" ]; then
		DEVS="$DEVS,$dev"
	elif network_get_physdev dev "$1" 2>/dev/null && [ -n "$dev" ]; then
		DEVS="$DEVS,$dev"
	fi
}
add_raw() { DEVS="$DEVS,$1"; }
add_type() { TYPES="$TYPES,$1"; }

start_service() {
	config_load tak-gateway
	local enabled callsign team role type lat lon hae gpsd gpsd_address beacon remarks
	config_get_bool enabled main enabled 0
	[ "$enabled" = 1 ] || return 0

	config_get callsign main callsign
	[ -n "$callsign" ] || callsign="$(uci -q get system.@system[0].hostname || cat /proc/sys/kernel/hostname)"
	config_get team main team Cyan
	config_get role main role "Team Member"
	config_get type main type a-f-G-U-C
	config_get lat main lat
	config_get lon main lon
	config_get hae main hae
	config_get_bool gpsd main gpsd 0
	config_get gpsd_address main gpsd_address 127.0.0.1:2947
	config_get beacon main beacon 30
	config_get remarks main remarks

	procd_open_instance
	procd_set_param command "$PROG"
	append_arg -callsign "$callsign"
	append_arg -team "$team"
	append_arg -role "$role"
	append_arg -type "$type"
	append_arg -lat "$lat"
	append_arg -lon "$lon"
	append_arg -hae "$hae"
	[ "$gpsd" = 1 ] && append_arg -gpsd "$gpsd_address"
	append_arg -beacon "${beacon}s"
	append_arg -remarks "$remarks"

	local s_enabled host port protocol cert key ca
	config_get_bool s_enabled server enabled 0
	if [ "$s_enabled" = 1 ]; then
		config_get host server host
		config_get port server port 8089
		config_get protocol server protocol ssl
		config_get cert server cert
		config_get key server key
		config_get ca server ca
		append_arg -server "$host"
		append_arg -port "$port"
		append_arg -proto "$protocol"
		if [ "$protocol" = ssl ]; then
			[ -f "$cert" ] && append_arg -cert "$cert"
			[ -f "$key" ] && append_arg -key "$key"
			[ -f "$ca" ] && append_arg -ca "$ca"
			append_bool -insecure server insecure 0
		fi
	fi

	local m_enabled ttl
	config_get_bool m_enabled mesh enabled 1
	if [ "$m_enabled" = 1 ]; then
		. /lib/functions/network.sh
		DEVS=""
		config_list_foreach mesh network add_device
		config_list_foreach mesh device add_raw
		append_arg -iface "${DEVS#,}"
		append_bool -chat mesh chat 1
		append_bool -to-server mesh to_server 1
		append_bool -from-server mesh from_server 1
		append_bool -bridge mesh bridge 1
		config_get ttl mesh ttl 1
		append_arg -ttl "$ttl"
		TYPES=""
		config_list_foreach mesh from_server_types add_type
		append_arg -from-server-types "${TYPES#,}"
	fi

	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

add_iface_trigger() { procd_add_interface_trigger "interface.*.up" "$1" /etc/init.d/tak-gateway restart; }

service_triggers() {
	procd_add_reload_trigger tak-gateway
	config_load tak-gateway
	config_list_foreach mesh network add_iface_trigger
}
